<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <TextView
        android:id="@+id/restrictionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/restrictionRed"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="16sp"
        android:gravity="center"
        android:padding="14dp"
        android:visibility="gone"
        android:text="@string/restriction_warning" />

    <TextView
        android:id="@+id/timerBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/accent"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="15sp"
        android:gravity="center"
        android:padding="10dp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp">

        <EditText
            android:id="@+id/addressBar"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:inputType="textUri"
            android:imeOptions="actionGo"
            android:hint="@string/address_bar_hint" />

        <Button
            android:id="@+id/goButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_go" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <Button android:id="@+id/backButton" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/action_back" />
            <Button android:id="@+id/forwardButton" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/action_forward" />
            <Button android:id="@+id/refreshButton" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/action_refresh" />
            <Button android:id="@+id/clearLogButton" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/action_clear_log" />
            <Button android:id="@+id/exportLogButton" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/action_export_log" />
            <Button android:id="@+id/copyLogButton" style="?android:attr/buttonStyleSmall"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="@string/action_copy_log" />
        </LinearLayout>
    </HorizontalScrollView>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/logToggleHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/panelHeader"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:padding="10dp"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/log_panel_title_expanded" />

    <LinearLayout
        android:id="@+id/logPanelBody"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:orientation="vertical"
        android:background="@color/panelBody"
        android:padding="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button android:id="@+id/tabLogButton" style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/tab_log" />
            <Button android:id="@+id/tabAvailabilityButton" style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/tab_availability" />
            <Button android:id="@+id/authTestButton" style="?android:attr/buttonStyleSmall"
                android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="@string/action_auth_test" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/filterRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/filterAll" style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/filter_all" />
                <Button android:id="@+id/filterApi" style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/filter_api" />
                <Button android:id="@+id/filterFetch" style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/filter_fetch_xhr" />
                <Button android:id="@+id/filterDocument" style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/filter_document" />
                <Button android:id="@+id/filterRsa" style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/filter_rsa_only" />
            </LinearLayout>
        </HorizontalScrollView>

        <EditText
            android:id="@+id/searchBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:hint="@string/search_hint" />

        <ListView
            android:id="@+id/logListView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:divider="@color/panelHeader"
            android:dividerHeight="1dp" />
    </LinearLayout>

</LinearLayout>
